# Copy to .env (never commit .env).
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# Local Postgres from `pnpm db:up` (docker-compose.yml, host port 5434)
DATABASE_URL=postgres://perch:perch@localhost:5434/perch
DATABASE_URL_TEST=postgres://perch:perch@localhost:5434/perch_test
# API (apps/api): `pnpm api:dev`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8787
WEB_ORIGIN=http://localhost:5173
# Unset = verification / reset links are logged to the API console.
RESEND_API_KEY=
MAIL_FROM=
# Optional "Continue with Google / Discord": set both of a pair or neither. Redirect URI:
# <BETTER_AUTH_URL>/api/auth/callback/google (and /discord).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# Set to 1 only behind a proxy (Caddy) that appends the client IP to X-Forwarded-For.
TRUST_PROXY=0
# API_PORT=8787
