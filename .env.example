# Copy to .env (never commit .env).
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# Local Postgres from `pnpm db:up` (docker-compose.yml, host port 5434)
DATABASE_URL=postgres://perch:perch@localhost:5434/perch
DATABASE_URL_TEST=postgres://perch:perch@localhost:5434/perch_test
# API (apps/api): `pnpm api:dev`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8787
WEB_ORIGIN=http://localhost:5173
# Unset = verification / reset links are logged to the API console.
RESEND_API_KEY=
MAIL_FROM=
# Steam Web API key (steamcommunity.com/dev/apikey) for the Steam library import; unset = sync answers 503.
STEAM_API_KEY=
# OpenXBL key (xbl.io) for the Xbox import; unset = Xbox link/sync answers 503. Free tier: 150 requests/hour.
OPENXBL_API_KEY=
# PlayStation NPSSO for the PSN import: sign in at playstation.com, then open
# https://ca.account.sony.com/api/v1/ssocookie and copy the `npsso` value. Lasts about two months;
# when the server logs "PSN_NPSSO expired, renew it", get a new one. Use a throwaway account.
# Unset = PSN link/sync answers 503.
PSN_NPSSO=
# Optional "Continue with Google / Discord": set both of a pair or neither. Redirect URI:
# <BETTER_AUTH_URL>/api/auth/callback/google (and /discord).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# Set to 1 only behind a proxy (Caddy) that appends the client IP to X-Forwarded-For.
TRUST_PROXY=0
# API_PORT=8787

# DeepSeek key for AI reasons on For you (unset keeps the template reasons)
DEEPSEEK_API_KEY=
# DeepSeek daily caps (UTC day). One batch = one LLM call, ~$0.0035 at peak deepseek-flash
# prices (2026-11). Defaults = ~$10/month worst case (95 calls/day). For-you reasons:
# LLM_DAILY_BATCH_CAP=60
# LLM_USER_DAILY_BATCH_CAP=10
# "What players say" summaries (own counters, cached a month per game):
# VOICE_DAILY_BATCH_CAP=35
# VOICE_USER_DAILY_CAP=15
# Also set a spend limit in the DeepSeek dashboard.
