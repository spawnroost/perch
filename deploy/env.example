# Perch production settings: copy to /srv/perch/.env on the server (chmod 600). Never commit the real file.
# Required: POSTGRES_PASSWORD, BETTER_AUTH_SECRET, BETTER_AUTH_URL, WEB_ORIGIN. Everything else is optional.

# --- Database (own Postgres container; the compose file builds DATABASE_URL from this) ---
# Hex only (it goes into a URL):  openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Auth / public origin (REQUIRED) ---
# openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://perch.spawnroost.com
WEB_ORIGIN=https://perch.spawnroost.com
# 1: behind Caddy, which appends the real client IP to X-Forwarded-For (rate limits key on it).
TRUST_PROXY=1

# --- Mail (Resend). Unset: verification/reset links are only logged to the api console. ---
RESEND_API_KEY=
MAIL_FROM="Perch <noreply@perch.spawnroost.com>"

# --- OAuth: set both of a pair or neither ---
# Redirect URIs to register:
#   Google:  https://perch.spawnroost.com/api/auth/callback/google
#   Discord: https://perch.spawnroost.com/api/auth/callback/discord
# Steam sign-in needs no key; its OpenID return URL is
#   https://perch.spawnroost.com/api/auth/steam/callback (realm https://perch.spawnroost.com).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Game data. Without IGDB the game routes answer 503. ---
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# Library imports (each unset answers its routes with 503).
STEAM_API_KEY=
OPENXBL_API_KEY=
# PlayStation NPSSO cookie: lasts about two months, then refresh it here.
PSN_NPSSO=

# --- LLM (DeepSeek): AI reasons on For you and the player-voice summaries. Unset: template reasons. ---
DEEPSEEK_API_KEY=
# Daily caps (global and per user), sized to roughly $10/month.
LLM_DAILY_BATCH_CAP=60
LLM_USER_DAILY_BATCH_CAP=10
VOICE_DAILY_BATCH_CAP=35
VOICE_USER_DAILY_CAP=15

# --- Web build (read by ship.sh on your machine, not by the server) ---
# Optional tip link; unset shows "coming soon".
VITE_SUPPORT_URL=

# --- Cron container (times UTC) ---
# IGDB backfills (art, facts, time to beat), every 6 h.
CACHE_AT="00:15 06:15 12:15 18:15"
# Full IGDB refresh of every cached game, weekly (1=Mon..7=Sun).
REFRESH_AT=04:30
REFRESH_DOW=7
# Daily pg_dump into the `backups` volume; keep the newest BACKUP_KEEP.
BACKUP_AT=02:00
BACKUP_KEEP=14
# Optional offsite copy of each dump to Cloudflare R2 (all four, or none).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BACKUP_BUCKET=

# --- Misc ---
TZ=UTC
# Set by ship.sh on every deploy; do not edit.
IMAGE_TAG=local
